# -------------------------------------------------------
# upload-api — required environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# -------------------------------------------------------

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/upload_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=upload_user
DB_PASSWORD=change_me

# JWT — use a long random string in production (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRATION_MS=86400000

# AWS S3
S3_BUCKET_NAME=your-bucket-name
S3_REGION=sa-east-1
